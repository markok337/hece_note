# hece_note 환경변수 템플릿
# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git에 올라가지 않는다.
# 발급 방법은 docs/setup.md 참고.

# ─────────────────────────────────────────────────────────────
# [앱에 들어가는 값] VITE_ 로 시작하는 값은 빌드된 JS에 그대로 박힌다.
# 저장소와 사이트가 공개라서 누구나 볼 수 있다. 공개돼도 안전한 값만 둔다.
# ─────────────────────────────────────────────────────────────

# Supabase > Project Settings > Data API > Project URL
VITE_SUPABASE_URL=

# Supabase > Project Settings > API Keys > Publishable key (sb_publishable_...)
# 공개돼도 된다. 실제 보호는 DB의 RLS 규칙과 로그인이 맡는다.
VITE_SUPABASE_PUBLISHABLE_KEY=

# 로그인용 고정 계정 ID. Supabase에 직접 만든 유일한 사용자의 이메일.
# 실제 메일이 오가지 않으므로 형식만 맞으면 된다. 개인 메일은 쓰지 않는다.
VITE_OWNER_LOGIN_ID=

# ─────────────────────────────────────────────────────────────
# [로컬 전용 값] 내 PC의 Python 스크립트(백업·마이그레이션)만 쓴다.
# 절대 VITE_ 접두사를 붙이지 않는다. 붙이면 앱에 섞여 공개된다.
# ─────────────────────────────────────────────────────────────

# Supabase > Project Settings > API Keys > Secret key (sb_secret_...)
# RLS를 무시하는 관리자 키. 유출되면 데이터 전부가 열린다.
SUPABASE_SECRET_KEY=

# Supabase > Connect > Connection string (Session pooler, URI)
# 비밀번호가 들어 있다. 스키마 변경·전체 백업용.
SUPABASE_DB_URL=

# 개인 키(로그인 비밀번호)는 여기 적지 않는다.
# 각 기기에서 앱을 처음 열 때 한 번만 입력한다.
